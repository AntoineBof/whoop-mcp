# --- App Whoop (developer.whoop.com) ---
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=

# --- URL publique du service Render, sans slash final ---
PUBLIC_BASE_URL=

# --- Secret qui protege l'endpoint MCP et le flux OAuth ---
# genere avec : openssl rand -hex 24
MCP_SECRET=

# --- Stockage durable du refresh token ---
# Sur Render : injecte automatiquement depuis le Key Value du blueprint.
REDIS_URL=
# Alternative : Upstash Redis via son API REST.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Optionnel : amorce manuelle du refresh token ---
WHOOP_REFRESH_TOKEN=
